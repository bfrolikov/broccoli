{
  "manifest_version": 3,
  "name": "Anti-brainrot Blocker",
  "version": "1.0.0",
  "description": "Pause YouTube videos until your server allows them.",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-blocker@bfrolikov.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.anti-brainrot-blocker.fyi/*"
  ],
  "background": {
    "scripts": [
      "compatibility.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Anti-brainrot Blocker"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "compatibility.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ]
}
